<div class="page memory-page">

    <div id="memoryHeader"></div>

    <!-- =========================
         MEMORY PRO
    ========================== -->

    <section class="memory-pro-section">

        <div class="memory-pro-header">

            <div>
                <h2>🧠 Memory Pro</h2>
                <p>
                    معلوماتك المهمة التي يمكن لـ UltraAI تذكرها واستخدامها لاحقاً.
                </p>
            </div>

            <button
                type="button"
                id="memoryProToggle"
                onclick="toggleMemoryPro()">
                ⏳
            </button>

        </div>

        <div id="memoryProStatus" class="memory-pro-status">
            جاري تحميل الذاكرة...
        </div>

        <div class="memory-pro-add">

            <textarea
                id="memoryProText"
                maxlength="500"
                rows="3"
                placeholder="مثال: أنا أبيع العسل وأريد التركيز على الزبناء في المغرب."></textarea>

            <div class="memory-pro-add-row">

                <select id="memoryProCategory">

                    <option value="general">عام</option>
                    <option value="preference">تفضيل</option>
                    <option value="project">مشروع</option>
                    <option value="business">عمل / تجارة</option>
                    <option value="goal">هدف</option>

                </select>

                <button
                    type="button"
                    onclick="addMemoryPro()">
                    ➕ حفظ المعلومة
                </button>

            </div>

        </div>

        <div
            id="memoryProList"
            class="memory-pro-list">

            <div class="memory-loading">
                جاري تحميل المعلومات...
            </div>

        </div>

    </section>


    <!-- =========================
         CONVERSATIONS MEMORY
    ========================== -->

    <section class="memory-conversations-section">

        <h2>💬 المحادثات المحفوظة</h2>

        <div class="memory-tools">

            <input
                id="memorySearch"
                type="search"
                placeholder="🔎 ابحث في المحادثات..."
                oninput="filterMemory()">

            <button
                type="button"
                onclick="loadMemory()">
                🔄 تحديث
            </button>

        </div>

        <div id="memoryList" class="memory-list">

            <div class="memory-loading">
                جاري تحميل المحادثات...
            </div>

        </div>

    </section>

</div>
